# คัดลอกเป็น .env.local (เครื่องตัวเอง) และใส่ค่าเดียวกันใน Vercel → Project Settings → Environment Variables
# ค่าฝั่ง server ล้วน — ห้ามใส่ NEXT_PUBLIC_ นำหน้า

# Web app URL ของ Google Apps Script (ลงท้าย /exec) — ดู scripts/loykrathong-apps-script.gs
APPS_SCRIPT_URL=

# รหัสลับที่ server แนบไปกับทุกออเดอร์ — ต้องตรงกับ Script Property "ORDER_SECRET" ใน Apps Script
# สร้างได้ด้วย: openssl rand -hex 24
ORDER_SECRET=
